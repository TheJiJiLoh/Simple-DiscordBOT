# Discord Bot Token (Required)
# Get this from the Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your_token_here

# Client Application ID (Required)
# Get this from the Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=your_client_id_here

# Guild ID (Optional)
# If provided, slash commands will be registered only to this guild (updates instantly).
# If left empty, commands will be registered globally (can take up to 1 hour to update).
GUILD_ID=your_guild_id_here

# Web Server Port (Optional, default is 3000)
# Used for Render health checks
PORT=3000
